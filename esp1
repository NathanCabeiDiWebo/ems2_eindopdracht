import network
import time
import socket

from wifi_secrets import SSID, PASSWORD

wlan = network.WLAN(network.STA_IF)
wlan.active(True)

wlan.connect(SSID, PASSWORD)  # Verbinden

print("Verbinding maken", end="")
while not wlan.isconnected():
    print(".", end="")
    time.sleep_ms(500)

print()

ip, subnet, gateway, dns = wlan.ifconfig()
print("IP-adres:\t", ip)
print("Subnetmasker:\t", subnet)
print("Gateway:\t", gateway)
print("DNS-server:\t", dns)

PORT = 2000
address = ("0.0.0.0", PORT)
print()

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind(address)
server.listen(1)
print("server luistert op", ip, PORT)

while True:
    client, client_address = server.accept()
    print("verbonden met:", client_address)
    try:
        while True:
            message = b"Ki wega G\n"
            client.sendall(message)
            print("msg sent!", message.strip())
            time.sleep(1)
            
    except OSError as e:
        print("Topa connection se fue")
        
    finally:
        client.close()
        print("connection closed")
